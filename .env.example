# Copy to .env and paste your key. Only ONE key is needed.
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ASR: gemini (default, same key) | groq (needs GROQ_API_KEY) | local (faster-whisper, offline)
ASR_BACKEND=gemini
GEMINI_ASR_MODEL=gemini-3.5-flash
# Faster/cheaper option for transcription: gemini-3.5-flash-lite
ASR_LANGUAGE=bn

# Optional, only if ASR_BACKEND=groq
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
# Only if ASR_BACKEND=local
LOCAL_ASR_MODEL=small

# direct  = one Gemini call hears the audio + whole KB (fastest, small KB only)
# cascade = separate ASR call -> retrieval -> LLM call (scales to big KBs)
PIPELINE_MODE=direct

# LLM
LLM_MODEL=gemini-3.5-flash
# Free tier = about 5 requests/minute PER MODEL. On a 429 the bot switches to these at once.
LLM_FALLBACK_MODELS=gemini-3.5-flash
# If no reply after N s, also ask the fallback model; first to answer wins. 0 = off.
HEDGE_AFTER_S=4
# Gemini 'thinking' adds latency and eats output tokens. minimal | low | medium | high | off
GEMINI_THINKING=minimal
# Give up on a slow Gemini call after N seconds and apologize instead of hanging.
GEMINI_TIMEOUT_S=12

# TTS: edge (Microsoft, no account) | gemini (same key) | mms (Meta MMS, offline)
# Run `python -m eval.bench_tts` to see which is fastest on your connection.
TTS_BACKEND=edge
TTS_VOICE=bn-BD-NabanitaNeural
# male voice: bn-BD-PradeepNeural
# English sentences use this voice instead (empty = always TTS_VOICE)
TTS_VOICE_EN=en-IN-NeerjaNeural
# Reuse audio of sentences already spoken (memory + cache/tts/). 0 = off.
TTS_CACHE=1
# How many TTS requests may run at once. 1 is fastest for Edge (see bench_tts --parallel).
TTS_CONCURRENCY=1
# Play a pre-made "জি, একটু দেখছি।" if the answer isn't ready after N ms. 0 = off.
FILLER_AFTER_MS=1500
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# VAD tuning. Lower VAD_MIN_SILENCE_MS = faster replies but more cut-offs mid-sentence.
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_S=15

RAG_TOP_K=3
REDACT_PII=1
